@startuml
allowmixing
!pragma layout smetana
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 18
skinparam shadowing false
component "Reporting GUI\nReportDashboard" as UI
rectangle "<<interface>>\nIReporting\ngetReport(requester, days)" as API
component "Reporting\nReportController" as RC
rectangle "<<interface>>\nIReportData\nloadReportData(from, asOf)" as Port
component "Data access adapter\nReportRepository" as Repo
database "Helpdesk storage\nTicket / TicketSla / Rating / SlaAlert" as DB
UI --> API : yêu cầu báo cáo
RC ..|> API
RC --> Port : chỉ đọc
Repo ..|> Port
Repo --> DB : snapshot truy vấn
note bottom of RC
  Thiết kế giao diện module nội bộ đề xuất.
  UC08 không cần dịch vụ AI hoặc hệ thống ngoài.
end note
@enduml

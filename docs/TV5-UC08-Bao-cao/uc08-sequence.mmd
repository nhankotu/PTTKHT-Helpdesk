sequenceDiagram
  autonumber
  actor User as Supervisor/Admin
  participant UI as ReportDashboard
  participant RC as ReportController
  participant Repo as ReportRepository
  participant Ticket as TicketService UC03

  User->>UI: openReport(days), default 30
  UI->>UI: showLoading()
  UI->>RC: getReport(requester, days)
  activate RC
  RC->>RC: authorizeAndValidate(requester, days)
  alt Unauthenticated, unauthorized, or invalid days
    RC-->>UI: 401 / 403 / 422
    UI-->>User: Sign in, access denied, or correct period
  else Valid request
    Note over RC,Repo: from = asOf - days * 24h; ticket/SLA/rating by ticket.createdAt; alerts by alert.createdAt
    RC->>Repo: loadReportData(from, asOf)
    activate Repo
    alt Data read failure
      Repo-->>RC: DataAccessError
      RC-->>UI: REPORT_UNAVAILABLE
      UI-->>User: Show error and retry with same period
    else Read succeeds
      Repo-->>RC: ReportData
      deactivate Repo
      RC->>RC: aggregateMetrics(data, asOf)
      RC-->>UI: ReportSummary
      UI->>UI: showSummary(report)
      UI-->>User: Show ticket, SLA, CSAT; null metrics display as —
      opt User selects a ticket from an alert (UC08.4)
        User->>UI: select(ticketId)
        UI->>Ticket: openTicket(requester, ticketId)
        activate Ticket
        Ticket->>Ticket: authorizeTicketAccess(requester, ticketId)
        alt Access allowed
          Ticket-->>UI: TicketDetail
          UI-->>User: Open ticket detail (UC03)
        else Missing ticket or access denied
          Ticket-->>UI: 403 / 404
          UI-->>User: Keep report and period; show access error
        end
        deactivate Ticket
      end
    end
  end
  deactivate RC

erDiagram
  USERS {
    INTEGER id PK
    TEXT name
    TEXT role
  }
  TEAMS {
    INTEGER id PK
    TEXT name UK
  }
  CATEGORIES {
    TEXT code PK
    TEXT name
    INTEGER team_id FK
  }
  SLA_POLICIES {
    INTEGER id PK
    INTEGER version
    TEXT priority
    INTEGER response_seconds
    INTEGER resolution_seconds
  }
  TICKETS {
    INTEGER id PK
    INTEGER customer_id FK
    TEXT category FK "nullable"
    INTEGER team_id FK "nullable"
    INTEGER assignee_id FK "nullable"
    TEXT status
    TEXT priority
    REAL created_at
    REAL updated_at
  }
  TICKET_SLA {
    INTEGER ticket_id PK, FK
    INTEGER policy_id FK
    REAL response_due
    REAL resolution_due
    REAL first_response_at "nullable"
    REAL resolved_at "nullable"
  }
  RATINGS {
    INTEGER ticket_id PK, FK
    INTEGER customer_id FK
    INTEGER score
    TEXT comment
    REAL created_at
  }
  SLA_ALERTS {
    INTEGER id PK
    INTEGER ticket_id FK
    TEXT deadline_type
    TEXT level
    REAL created_at
  }


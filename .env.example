# Database (MySQL 8.0+)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=helpdesk
DB_USER=helpdesk_user
DB_PASSWORD=helpdesk_pass
DB_ROOT_PASSWORD=root_pass

# JWT Security (tối thiểu 32 bytes / 256-bit cho HS256)
JWT_SECRET=ChangeThisToAStrongRandomSecretKeyAtLeast32BytesLong!
JWT_ACCESS_EXPIRATION_SECONDS=3600
JWT_REFRESH_EXPIRATION_SECONDS=604800

# AI Integration (Google Gemini Developer API - dùng cho UC04 & UC07)
# Đặt AI_PROVIDER=mock để chạy offline/test không gọi API ngoài, hoặc AI_PROVIDER=gemini khi có key
AI_PROVIDER=mock
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMS=768
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_TIMEOUT_MS=15000

# Server
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

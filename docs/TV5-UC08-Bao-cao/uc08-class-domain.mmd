classDiagram
direction LR

class Ticket {
  +int id
  +int customerId
  +string subject
  +Channel channel
  +TicketStatus status
  +Priority priority
  +datetime createdAt
  +datetime updatedAt
  +int version
}

class User {
  +int id
  +string name
  +UserRole role
  +bool active
}

class Team {
  +int id
  +string name
}

class Category {
  +string code
  +string name
}

class SlaPolicy {
  +int id
  +int version
  +Priority priority
  +int responseSeconds
  +int resolutionSeconds
}

class TicketSla {
  +int ticketId
  +int policyId
  +datetime responseDue
  +datetime resolutionDue
  +datetime firstResponseAt
  +datetime resolvedAt
}

class Rating {
  +int ticketId
  +int userId
  +int score
  +string comment
  +datetime createdAt
}

class SlaAlert {
  +int id
  +int ticketId
  +DeadlineType deadlineType
  +AlertLevel level
  +datetime createdAt
}

class Channel {
  <<enumeration>>
  WEB
  EMAIL
}

class TicketStatus {
  <<enumeration>>
  NEW
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

class Priority {
  <<enumeration>>
  URGENT
  HIGH
  NORMAL
  LOW
}

class UserRole {
  <<enumeration>>
  CUSTOMER
  AGENT
  SUPERVISOR
  ADMIN
}

class DeadlineType {
  <<enumeration>>
  RESPONSE
  RESOLUTION
}

class AlertLevel {
  <<enumeration>>
  WARNING
  OVERDUE
}

Ticket "0..*" --> "1" User : customer
Ticket "0..*" --> "0..1" User : assignee
Ticket "0..*" --> "0..1" Team : routed team
Ticket "0..*" --> "0..1" Category : category
Team "0..*" --> "0..1" User : members
Team "1" <-- "0..*" Category : default routing
Ticket "1" *-- "1" TicketSla : SLA snapshot
SlaPolicy "1" <-- "0..*" TicketSla : applied policy
Ticket "1" *-- "0..1" Rating : customer evaluation
Ticket "1" *-- "0..*" SlaAlert : alert history

note for TicketSla "One row per ticket; stores due and actual timestamps used by UC08.2."
note for Rating "At most one rating per ticket in the current schema."
note for SlaPolicy "Versioned policy; applied policy is referenced by each TicketSla."

@startuml
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 18
skinparam shadowing false
actor "Supervisor hoặc Admin" as User
boundary ReportDashboard as UI
control ReportController as RC
participant "ReportRepository\n<<repository>>" as Repo
User -> UI: 1: openReport(days)
UI -> UI: showLoading()
UI -> RC: 1.1: getReport(requester, days)
activate RC
RC -> RC: 1.1.1: authorizeAndValidate(requester, days)
alt Chưa đăng nhập / sai quyền / days không hợp lệ
  RC --> UI: error: 401 / 403 / 422
  UI -> UI: showError(error)
  UI --> User: Đăng nhập lại / từ chối / sửa kỳ
else Hợp lệ
  note right of RC: from = asOf - days × 24 giờ
  RC -> Repo: 1.1.2: loadReportData(from, asOf)
  activate Repo
  note right of Repo
    Ticket/SLA và rating: theo cohort ngày tạo ticket.
    Cảnh báo: theo ngày phát sinh cảnh báo, tối đa 30.
    Thiết kế đề xuất: cùng một snapshot dữ liệu.
  end note
  alt Lỗi đọc dữ liệu
    Repo --> RC: DataAccessError
    RC --> UI: error: REPORT_UNAVAILABLE
    UI -> UI: showError(error)
    UI --> User: Báo lỗi; cho thử lại cùng kỳ
  else Đọc thành công
    Repo --> RC: data: ReportData
    RC -> RC: 1.1.3: aggregateMetrics(data, asOf)
    RC --> UI: report: ReportSummary
    UI -> UI: 1.2: showSummary(report)
    UI --> User: Hiện từng khối; thiếu mẫu thì hiện “—”
  end
  deactivate Repo
end
deactivate RC
@enduml

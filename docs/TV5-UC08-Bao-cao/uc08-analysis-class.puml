@startuml
!pragma layout smetana
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 17
skinparam classAttributeIconSize 0
skinparam shadowing false
class ReportDashboard <<boundary>> {
  +openReport(days)
  +showLoading()
  +showSummary(report)
  +showError(error)
  +openTicket(ticketId)
}
class ReportController <<control>> {
  +getReport(requester, days): ReportSummary
  +authorizeAndValidate(requester, days)
  +aggregateMetrics(data, asOf): ReportSummary
}
class ReportRepository <<repository>> {
  +loadReportData(from, asOf): ReportData
}
class ReportData <<DTO>> {
  tickets: List<Ticket>
  ratings: List<Rating>
  alerts: List<SlaAlert>
}
class ReportSummary <<DTO>> {
  total: Integer
  open: Integer
  overdue: Integer
  avgResponseSeconds: Decimal?
  avgResolutionSeconds: Decimal?
  slaCompliance: Decimal?
  csat: Decimal?
  ratingCount: Integer
  statuses: Map
  categories: Map
  alerts: List<SlaAlert>
}
class Ticket <<entity>> {
  id: Integer
  createdAt: DateTime
  status: TicketStatus
  category: Category?
}
class TicketSla <<entity>> {
  firstResponseAt: DateTime?
  resolvedAt: DateTime?
  responseDue: DateTime
  resolutionDue: DateTime
}
class Rating <<entity>> {
  score: Integer [1..5]
  createdAt: DateTime
}
class SlaAlert <<entity>> {
  deadlineType: RESPONSE | RESOLUTION
  level: WARNING | OVERDUE
  createdAt: DateTime
}
ReportDashboard --> ReportController
ReportController --> ReportRepository
ReportController ..> ReportSummary : tạo
ReportRepository ..> ReportData : trả về
ReportData o-- Ticket
ReportData o-- Rating
ReportData o-- SlaAlert
Ticket "1" *-- "1" TicketSla
Ticket "1" -- "0..1" Rating
Ticket "1" -- "0..*" SlaAlert
note bottom of ReportRepository
  Mô hình thiết kế đề xuất.
  Prototype hiện truy vấn trực tiếp trong reports().
  Repository lấy dữ liệu nhất quán theo một mốc asOf.
end note
@enduml

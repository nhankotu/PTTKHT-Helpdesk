@startuml
!pragma layout smetana
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 18
skinparam shadowing false
[*] --> Loading : Mở UI-R01 / mặc định 30 ngày
state "Đang tải báo cáo" as Loading
state "UI-R01 — Tổng quan" as Overview
state "UI-R02 — Chi tiết SLA" as Sla
state "Thông báo lỗi / Thử lại" as Error
state "Không có quyền xem báo cáo" as Forbidden
state "Đăng nhập" as Login
state "Chi tiết ticket (UC03)" as Ticket
Loading --> Overview : Thành công / tab tổng quan
Loading --> Error : Lỗi đọc / mất kết nối
Loading --> Forbidden : 403
Loading --> Login : 401
Error --> Loading : Thử lại / giữ days và tab
Overview --> Loading : Đổi kỳ hợp lệ / Tải lại
Overview --> Sla : Chọn Chi tiết SLA / giữ days
Sla --> Overview : Quay lại tổng quan / giữ days
Sla --> Loading : Đổi kỳ / giữ tab SLA
Loading --> Sla : Thành công / tab SLA
Sla --> Ticket : Chọn cảnh báo + đủ quyền
Ticket --> Sla : Quay lại / giữ kỳ và vị trí cuộn
Forbidden --> [*] : Quay về trang được phép
@enduml
